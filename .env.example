# Environment variables
# DO NOT commit real keys to version control.
# Copy this file to .env and fill in the values.

# OAuth 2.1 Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Session (32+ chars; generate a random string for production)
SESSION_SECRET="dev-session-secret-change-in-prod-32ch"

# Optional: separate AES-GCM key material for server-side OAuth credential encryption.
# Falls back to SESSION_SECRET when unset.
CREDENTIAL_ENCRYPTION_KEY=""

# OAuth Redirect URIs (must be registered in provider consoles)
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/callback?provider=google"
MICROSOFT_REDIRECT_URI="http://localhost:3000/auth/callback?provider=microsoft"

# API & SDKs (Google Gemini)
GOOGLE_GENERATIVE_AI_API_KEY=""

# App Configuration
NODE_ENV="development"
PORT="3000"
